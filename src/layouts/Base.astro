---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { site, hours } from '../data/site';
import barlow900 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-900-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const hoursJson = JSON.stringify(hours.map(({ day, open, close }) => ({ day, open, close })));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={barlow900} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#E4E2DC" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-signal focus:px-4 focus:py-3 focus:font-bold"
      >Aller au contenu</a
    >
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <CallBar />
    <script is:inline define:vars={{ hoursJson }}>
      // Statut Ouvert / Fermé, calculé à l'heure de Paris.
      (function () {
        var H = JSON.parse(hoursJson);
        var days = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
        var parts = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
        }).formatToParts(new Date());
        var get = function (t) { return (parts.find(function (p) { return p.type === t; }) || {}).value; };
        var wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
        var now = parseInt(get('hour'), 10) * 60 + parseInt(get('minute'), 10);
        var toMin = function (t) { var a = t.split(':'); return +a[0] * 60 + +a[1]; };
        var fmt = function (t) { return t.replace(':', 'h'); };
        var today = H.find(function (h) { return h.day === wd; });
        var open = false, msg = '';
        if (today && now >= toMin(today.open) && now < toMin(today.close)) {
          open = true;
          msg = 'Ouvert jusqu’à ' + fmt(today.close);
        } else if (today && now < toMin(today.open)) {
          msg = 'Fermé, ouvre à ' + fmt(today.open);
        } else {
          for (var i = 1; i <= 7; i++) {
            var d = (wd + i) % 7;
            var n = H.find(function (h) { return h.day === d; });
            if (n) { msg = 'Fermé, ouvre ' + (i === 1 ? 'demain' : days[d]) + ' à ' + fmt(n.open); break; }
          }
        }
        document.querySelectorAll('[data-status]').forEach(function (el) {
          el.setAttribute('data-open', open ? 'true' : 'false');
          var t = el.querySelector('[data-status-text]');
          if (t) t.textContent = msg;
        });
        document.querySelectorAll('[data-day="' + wd + '"]').forEach(function (el) {
          el.setAttribute('data-today', 'true');
        });
      })();
    </script>
  </body>
</html>
