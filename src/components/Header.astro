---
import { site } from '../data/site';
const nav = [
  { href: '/#demande', label: 'Demander une pièce' },
  { href: '/#services', label: 'Services' },
  { href: '/#garantie', label: 'Garantie' },
  { href: '/#infos', label: 'Horaires & accès' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="border-b-4 border-ink bg-concrete">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-3 px-4 py-3 md:px-6">
    <!-- Panneau routier -->
    <a
      href="/"
      class="group flex shrink-0 items-stretch border-[3px] border-ink bg-signal p-[3px] shadow-[4px_4px_0_var(--color-ink)]"
      aria-label={`${site.name}, accueil`}
    >
      <span class="flex items-center gap-2 border-2 border-ink px-2 py-1.5 sm:gap-3 sm:px-3">
        <span translate="no" class="sign text-[2.1rem] font-black leading-none sm:text-[2.4rem]">MSA</span>
        <span class="hidden flex-col leading-tight min-[380px]:flex">
          <span class="sign text-[0.95rem] font-extrabold sm:text-[1.05rem]">Multi Services Auto</span>
          <span class="sign text-[0.95rem] font-extrabold sm:text-[1.05rem]">Groslay</span>
        </span>
        <span class="cartouche px-2 py-1 text-[1.2rem] sm:text-[1.35rem]" aria-hidden="true">N1</span>
      </span>
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-[44px] items-center px-3 font-semibold underline-offset-4 hover:underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={site.phoneHref} class="btn btn-ink hidden text-[1.25rem] md:inline-flex">
      {site.phone}
    </a>

    <details class="relative lg:hidden md:ml-0">
      <summary
        class="btn btn-paper cursor-pointer list-none px-4 text-[1.15rem] [&::-webkit-details-marker]:hidden"
        aria-label="Ouvrir le menu"
      >
        Menu
      </summary>
      <nav
        aria-label="Navigation mobile"
        class="absolute right-0 top-[calc(100%+8px)] z-40 w-[min(82vw,300px)] border-[3px] border-ink bg-paper shadow-[6px_6px_0_var(--color-ink)]"
      >
        <ul>
          {
            nav.map((item) => (
              <li class="border-b-2 border-concrete last:border-0">
                <a href={item.href} class="flex min-h-[48px] items-center px-4 font-semibold">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  // Referme le menu mobile après un clic sur un lien.
  document.querySelectorAll('header details nav a').forEach(function (a) {
    a.addEventListener('click', function () {
      a.closest('details').removeAttribute('open');
    });
  });
</script>
