---
import { site } from '../data/site';
const hasWhatsapp = site.whatsapp.length > 0;
---

<form
  id="demande-form"
  class="relative border-[3px] border-ink bg-paper shadow-[8px_8px_0_var(--color-ink)]"
  action="https://api.web3forms.com/submit"
  method="POST"
  novalidate
  data-key={site.web3formsKey}
  data-whatsapp={site.whatsapp}
  aria-labelledby="demande-titre"
>
  <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1 border-b-[3px] border-ink bg-signal px-5 py-3">
    <h2 id="demande-titre" class="sign text-[2.3rem] font-black">Demander une pièce</h2>
    <p class="pb-1 text-[0.95rem] font-semibold">Réponse par téléphone ou SMS</p>
  </div>

  <div class="px-5 pb-5 pt-4">
    <div data-summary role="alert" tabindex="-1" hidden class="mb-4 border-[3px] border-stock p-3">
      <p class="font-bold text-stock">Il manque des informations :</p>
      <ul class="mt-1 list-disc pl-5 text-[0.95rem]"></ul>
    </div>

    <input type="hidden" name="access_key" value={site.web3formsKey} />
    <input type="hidden" name="subject" value="Demande de pièce — site MSA" />
    <input type="hidden" name="from_name" value="Site MSA Multi Services Auto" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
      <div class="field">
        <label for="f-marque">Marque *</label>
        <input id="f-marque" name="marque" required autocomplete="off" placeholder="Peugeot…" aria-describedby="e-marque" />
        <p id="e-marque" class="error" hidden>Indiquez la marque du véhicule.</p>
      </div>
      <div class="field">
        <label for="f-modele">Modèle *</label>
        <input id="f-modele" name="modele" required autocomplete="off" placeholder="208…" aria-describedby="e-modele" />
        <p id="e-modele" class="error" hidden>Indiquez le modèle.</p>
      </div>
      <div class="field">
        <label for="f-annee">Année *</label>
        <input id="f-annee" name="annee" required inputmode="numeric" maxlength="4" pattern="(19|20)[0-9]{2}" placeholder="2016…" aria-describedby="e-annee" />
        <p id="e-annee" class="error" hidden>Indiquez l'année sur 4 chiffres, par exemple 2016.</p>
      </div>
      <div class="field">
        <label for="f-moteur">Motorisation</label>
        <input id="f-moteur" name="motorisation" autocomplete="off" placeholder="1.2 PureTech…" />
      </div>
      <div class="field sm:col-span-2">
        <label for="f-immat">Immatriculation <span class="font-normal text-concrete-dark">(facultatif, utile pour trouver la bonne référence)</span></label>
        <input id="f-immat" name="immatriculation" autocomplete="off" placeholder="AB-123-CD…" spellcheck="false" class="uppercase" />
      </div>
      <div class="field sm:col-span-2">
        <label for="f-piece">Pièce recherchée *</label>
        <textarea id="f-piece" name="piece" required rows="2" placeholder="Boîte de vitesses 6 rapports, rétroviseur gauche…" aria-describedby="e-piece"></textarea>
        <p id="e-piece" class="error" hidden>Décrivez la pièce que vous cherchez.</p>
      </div>
      <div class="field sm:col-span-2">
        <label for="f-tel">Votre téléphone *</label>
        <input id="f-tel" name="telephone" type="tel" required autocomplete="tel" placeholder="06 12 34 56 78…" aria-describedby="e-tel" />
        <p id="e-tel" class="error" hidden>Indiquez un numéro à 10 chiffres pour qu'on puisse vous rappeler.</p>
      </div>
    </div>

    <div class="field mt-4">
      <div class="flex items-start gap-3">
        <input id="f-rgpd" name="consentement" type="checkbox" required value="oui" class="mt-0.5 !h-6 !min-h-0 !w-6 shrink-0 accent-ink" aria-describedby="e-rgpd" />
        <label for="f-rgpd" class="!font-normal !text-[0.9rem] leading-snug">
          J'accepte que MSA Multi Services Auto utilise ces informations pour répondre à ma demande.{" "}
          <a href="/confidentialite/" class="underline underline-offset-2">Confidentialité</a> *
        </label>
      </div>
      <p id="e-rgpd" class="error" hidden>Cochez la case pour envoyer la demande.</p>
    </div>

    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
      <button type="submit" class="btn btn-ink sm:flex-[1.7]">Envoyer ma demande</button>
      {
        hasWhatsapp ? (
          <button type="button" data-wa class="btn btn-paper sm:flex-1">
            Envoyer par WhatsApp
          </button>
        ) : (
          <button type="button" class="btn btn-paper sm:flex-1 cursor-not-allowed opacity-70" disabled aria-describedby="wa-note">
            WhatsApp
          </button>
        )
      }
    </div>
    {!hasWhatsapp && <p id="wa-note" class="mt-2 text-[0.85rem] text-concrete-dark">Envoi par WhatsApp : numéro <span class="todo">[À CONFIRMER]</span></p>}

    <p data-result role="status" class="mt-4 font-semibold empty:hidden"></p>
  </div>
</form>

<script>
  const form = document.getElementById('demande-form') as HTMLFormElement | null;
  if (form) {
    const phone = '01 39 84 17 91';
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const result = form.querySelector<HTMLElement>('[data-result]')!;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]'));

    const isValid = (el: HTMLInputElement | HTMLTextAreaElement) => {
      if (el instanceof HTMLInputElement && el.type === 'checkbox') return el.checked;
      const v = el.value.trim();
      if (!v) return false;
      if (el.name === 'telephone') return v.replace(/\D/g, '').length >= 10;
      if (el.name === 'annee') return /^(19|20)\d{2}$/.test(v);
      return true;
    };
    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const ok = isValid(el);
      const err = form.querySelector<HTMLElement>('#' + el.getAttribute('aria-describedby'));
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      if (err) err.hidden = ok;
      return ok;
    };
    fields.forEach((el) =>
      el.addEventListener('blur', () => {
        if (el.value || el.getAttribute('aria-invalid')) check(el);
      }),
    );
    form.querySelectorAll<HTMLInputElement>('input[type=checkbox][required]').forEach((el) =>
      el.addEventListener('change', () => check(el)),
    );

    const validateAll = () => {
      const bad = fields.filter((el) => !check(el));
      const list = summary.querySelector('ul')!;
      list.innerHTML = '';
      bad.forEach((el) => {
        const msg = form.querySelector('#' + el.getAttribute('aria-describedby'))?.textContent ?? '';
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + el.id;
        a.textContent = msg;
        a.className = 'underline';
        a.addEventListener('click', (e) => {
          e.preventDefault();
          el.focus();
        });
        li.append(a);
        list.append(li);
      });
      summary.hidden = bad.length === 0;
      if (bad.length) summary.focus();
      return bad.length === 0;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      result.textContent = '';
      if (!validateAll()) return;
      const key = form.dataset.key;
      if (!key) {
        result.textContent = `L'envoi en ligne n'est pas encore activé. Appelez-nous au ${phone}.`;
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      btn.textContent = 'Envoi en cours…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error();
        form.reset();
        fields.forEach((el) => el.removeAttribute('aria-invalid'));
        result.textContent = 'Demande envoyée. On vérifie le stock et on vous rappelle ou on vous répond par SMS.';
      } catch {
        result.textContent = `La demande n'est pas partie. Réessayez, ou appelez-nous au ${phone}.`;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Envoyer ma demande';
      }
    });

    form.querySelector<HTMLButtonElement>('[data-wa]')?.addEventListener('click', () => {
      const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() || '-';
      const text = [
        'Bonjour, je cherche une pièce :',
        `Véhicule : ${v('marque')} ${v('modele')} (${v('annee')})`,
        `Motorisation : ${v('motorisation')}`,
        `Immatriculation : ${v('immatriculation')}`,
        `Pièce : ${v('piece')}`,
      ].join('\n');
      window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  }
</script>
