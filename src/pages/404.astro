---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Page introuvable | MSA Multi Services Auto" description="Cette page n’existe pas sur le site de MSA Multi Services Auto, Groslay." noindex>
  <section class="bg-signal">
    <div class="mx-auto max-w-[1240px] px-4 py-20 md:px-6">
      <p class="hazard h-4 max-w-[420px]" aria-hidden="true"></p>
      <h1 class="sign mt-8 text-[3.4rem] font-black sm:text-[5rem]">Route barrée</h1>
      <p class="mt-4 max-w-[46ch] text-[1.15rem]">Cette page n’existe pas ou a changé d’adresse. Reprenez par l’accueil, ou appelez-nous.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-ink">Retour à l’accueil</a>
        <a href={site.phoneHref} class="btn btn-paper">{site.phone}</a>
      </div>
    </div>
  </section>
</Base>
